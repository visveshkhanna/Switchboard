{
  "name": "switchboard-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=mcp-switchboard --filter=@switchboard/web",
    "test": "turbo run test",
